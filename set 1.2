# 4. Create variables of type int, float, str, bool, and display their data types using type().
print("Q4:")
var_int = 42
var_float = 3.14
var_str = "Hello"
var_bool = True
print(f"int: {var_int} -> {type(var_int)}")
print(f"float: {var_float} -> {type(var_float)}")
print(f"str: {var_str} -> {type(var_str)}")
print(f"bool: {var_bool} -> {type(var_bool)}")
print()

