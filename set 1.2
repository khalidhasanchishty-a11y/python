# 2. Swap the values of two variables using both the traditional method and Python's tuple unpacking.
print("Q2:")
a, b = 10, 20
print(f"Before swap (traditional): a = {a}, b = {b}")
# Traditional method
temp = a
a = b
b = temp
print(f"After swap (traditional): a = {a}, b = {b}")

# Reset values
a, b = 10, 20
print(f"Before swap (tuple unpacking): a = {a}, b = {b}")
# Pythonic tuple unpacking
a, b = b, a
print(f"After swap (tuple unpacking): a = {a}, b = {b}")
print()

