# 6. Assign the same value to three variables and verify using 'is'.
print("Q6:")
p = q = r = 100
print(f"p = {p}, q = {q}, r = {r}")
print(f"p is q: {p is q}")
print(f"q is r: {q is r}")
print(f"p is r: {p is r}")
print()

# 7. Delete a variable using del and observe the error when trying to access it.
print("Q7:")
temp_var = "I will be deleted"
print(f"Before del: temp_var = {temp_var}")
del temp_var
try:
    print(temp_var)  # This will raise NameError
except NameError as e:
    print(f"Error after del: {e}")
print()

