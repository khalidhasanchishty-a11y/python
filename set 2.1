# Q1. Positive, Negative or Zero

num = int(input("Q1 - Enter a number: "))

if num > 0:
    print("Positive")
elif num < 0:
    print("Negative")
else:
    print("Zero")


# Q2. Even or Odd

num = int(input("\nQ2 - Enter an integer: "))

if num % 2 == 0:
    print("Even")
else:
    print("Odd")


# Q3. Largest Among Three Numbers

a = int(input("\nQ3 - Enter first number: "))
b = int(input("Enter second number: "))
c = int(input("Enter third number: "))

if a >= b and a >= c:
    print("Largest =", a)
elif b >= a and b >= c:
    print("Largest =", b)
else:
    print("Largest =", c)


# Q4. Grade According to Marks

marks = int(input("\nQ4 - Enter marks: "))

if marks >= 90:
    print("Grade A")
elif marks >= 75:
    print("Grade B")
elif marks >= 60:
    print("Grade C")
elif marks >= 40:
    print("Grade D")
else:
    print("Fail")


# Q5. Leap Year

year = int(input("\nQ5 - Enter year: "))

if year % 400 == 0:
    print("Leap Year")
elif year % 100 == 0:
    print("Not a Leap Year")
elif year % 4 == 0:
    print("Leap Year")
else:
    print("Not a Leap Year")


# Q6. ATM Withdrawal

correct_pin = 1234
pin = int(input("\nQ6 - Enter PIN: "))

balance = 10000
amount = int(input("Enter withdrawal amount: "))

if pin != correct_pin:
    print("Incorrect PIN")
elif amount > balance:
    print("Insufficient Balance")
else:
    balance = balance - amount
    print("Withdrawal Successful")
    print("Remaining Balance =", balance)


# Q7. Scholarship Eligibility

