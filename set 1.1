# Q1. Arithmetic Operations

a = int(input("Enter first integer: "))
b = int(input("Enter second integer: "))

print("Addition =", a + b)
print("Subtraction =", a - b)
print("Multiplication =", a * b)
print("Division =", a / b)
print("Floor Division =", a // b)
print("Modulus =", a % b)
print("Exponentiation =", a ** b)


# Q2. Assignment Operators

num = int(input("\nEnter an integer: "))

num += 10
print("After += 10:", num)

num -= 5
print("After -= 5:", num)

num *= 2
print("After *= 2:", num)

num /= 3
print("After /= 3:", num)


# Q3. Comparison Operators

a = int(input("\nEnter first number: "))
b = int(input("Enter second number: "))

print("Equal:", a == b)
print("Not Equal:", a != b)
print("First Greater:", a > b)
print("First Less or Equal:", a <= b)


