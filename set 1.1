# Q9. Bitwise AND and OR

a = int(input("\nEnter first integer: "))
b = int(input("Enter second integer: "))

print("AND (&) =", a & b)
print("OR (|) =", a | b)


# Q10. XOR, NOT and Scholarship

a = int(input("\nEnter an integer: "))
b = int(input("Enter another number: "))

print("XOR (^) =", a ^ b)
print("NOT (~) =", ~a)

mark1 = int(input("Enter first mark: "))
mark2 = int(input("Enter second mark: "))

if mark1 >= 90 or mark2 >= 90:
    print("Eligible for Scholarship")

failed = mark1 < 35 or mark2 < 35

print("Student has not failed:", not failed)


# Q11. Bit Shifting

num = int(input("\nEnter a number: "))

print("Left Shift =", num << 2)
print("Right Shift =", num >> 2)


# Q12. Logical AND

a = int(input("\nEnter first number: "))
b = int(input("Enter second number: "))
c = int(input("Enter third number: "))

result = a > b and c > a

print("Result =", result)
