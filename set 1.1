# Q5. In Operator

sentence = input("\nEnter a sentence: ")
word = input("Enter a word: ")

print("Word present:", word in sentence)


# Q6. Not In Operator

sentence = input("\nEnter a sentence: ")
word = input("Enter a word: ")

print("Word not present:", word not in sentence)


